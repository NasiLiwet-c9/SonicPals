#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["TreeItem", "MangoItem"]
    def "TreeItem" (
        active = true
        references = @Realistic_looking_Mango_Tree.usdz@
    )
    {
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        float3 xformOp:translate = (0.0011751316, 0, 0.0061166286)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Materials"
        {
            over "Steam_color"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Material_001"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }

            over "Leaf"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }
        }
    }

    def "MangoItem" (
        customData = {
            float3 rotationEulerHint = (0, 0, 0)
        }
        references = @Mango.usdz@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.0030895493, 0.0030895493, 0.0030895493)
        float3 xformOp:translate = (-0.7349935, 1.0912825, -0.31635478)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

